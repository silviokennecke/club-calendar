# Dummy values for the build-time cache warmup in docker/Dockerfile (nothing here is used at runtime;
# real values come from the container environment, see docker/entrypoint.sh).
# Add a variable here when the Symfony config starts requiring a new one.
APP_SECRET=build
JWT_REFRESH_SECRET=build
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost
DATABASE_URL=mysql://user:pass@localhost:3306/db
