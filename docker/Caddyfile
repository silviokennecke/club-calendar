{
	admin off
	auto_https off
	servers {
		# TLS terminates at the reverse proxy in front of the container
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /var/www/app/public

	log {
		output stdout
	}

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API -> Symfony front controller via PHP-FPM
	handle /api/* {
		request_body {
			max_size 16MB
		}
		php_fastcgi 127.0.0.1:9000
	}

	# everything else -> built SPA; unknown paths fall back to index.html (client-side routes)
	handle {
		# explicit order: block first, then the fallback and file server
		route {
			@private path /index.php /.htaccess
			respond @private 404

			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			@html not path /assets/*
			header @html Cache-Control "no-cache"

			try_files {path} /index.html
			file_server
		}
	}
}
