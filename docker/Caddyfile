{
	admin off
	auto_https off
	servers {
		# TLS terminates at the reverse proxy in front of the container
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /var/www/html/public

	log {
		output stdout
	}

	encode zstd gzip

	# Feed pages (SPA) and feed API: never send a Referer
	@feed path /feed/* /api/feed/*
	header @feed Referrer-Policy no-referrer

	header {
		# KEEP IN SYNC with backend/public/.htaccess (tests/Unit/SecurityHeadersConfigTest.php)
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		?Referrer-Policy "strict-origin-when-cross-origin"
		# No HSTS here: TLS ends at the proxy in front, which must send Strict-Transport-Security
		-Server
	}

	# API -> Symfony front controller via PHP-FPM
	handle /api/* {
		request_body {
			max_size 16MB
		}
		php_fastcgi 127.0.0.1:9000 {
			try_files /index.php =404
		}
	}

	# everything else -> built SPA; unknown paths fall back to index.html (client-side routes)
	handle {
		# explicit order: block first, then the fallback and file server
		route {
			@private path /index.php /.htaccess *.env *.pem *.log
			respond @private 404

			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			@html not path /assets/*
			header @html Cache-Control "no-cache"

			try_files {path} /index.html
			file_server
		}
	}
}
