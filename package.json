{
  "name": "club-calendar",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:dev": "npm run build:dev --workspace=backend && npm run build:dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "migrate": "npm run migrate --workspace=backend",
    "fixtures": "npm run fixtures --workspace=backend",
    "deploy": "backend/vendor/bin/dep deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --fix --config frontend/eslint.config.mjs",
      "prettier --write"
    ],
    "frontend/**/*.{css,json,md,yaml,yml}": [
      "prettier --write"
    ],
    "backend/translations/**/*.json": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "wait-on": "^9.0.10"
  }
}
