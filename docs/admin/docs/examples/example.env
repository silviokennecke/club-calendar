# Save this file as ".env" next to docker-compose.yml, then replace each placeholder value.
# Generate a secret with:  openssl rand -hex 32
# Everything not listed here: see configuration/reference.md in this guide.

# --- Required ---------------------------------------------------------------
# Public address of the app, no trailing slash
APP_URL=https://calendar.example.com
# Domain only (used by the bundled proxy in docker-compose.override.yml)
APP_DOMAIN=calendar.example.com
# Two different random secrets
APP_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Changing APP_SECRET later: see operations.md ("Changing APP_SECRET"); temporarily set APP_SECRET_PREVIOUS and JWT_PASSPHRASE
# Name of your installation: page title, e-mails, passkey prompt (optional, default: Club Calendar)
# APP_NAME=Club Calendar

# Database (use letters and digits only, e.g. openssl rand -hex 24)
DB_NAME=club_calendar
DB_USER=club_calendar
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# Image version: latest, a version such as 1.2.3, or main
APP_IMAGE_TAG=latest

# --- Mail (without it, no mails are sent and registration cannot be confirmed) ---
MAILER_DSN=smtp://user:password@smtp.example.com:587
MAILER_FROM="Club Calendar <noreply@example.com>"

# --- Optional ---------------------------------------------------------------
# Maps
# MAPBOX_TOKEN=

# Single sign-on (see configuration/sso.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Only people with an open club invitation may register (true/false)
# RESTRICT_REGISTRATION=false

# Only you (on the command line) may create clubs (true/false)
# RESTRICT_CLUB_CREATION=false

# City and country in security notices (see Security, "Location in security notices").
# A free MaxMind account gives the keys; using the GeoLite2 database means accepting MaxMind's licence terms.
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
# Without a MaxMind key only the country from your CDN header is used, and only behind a trusted proxy
# CLIENT_COUNTRY_HEADER=CF-IPCountry


# Links to your legal documents if you do not mount Markdown files in ./legal
# LEGAL_IMPRINT_URL=
# LEGAL_PRIVACY_URL=
# LEGAL_TERMS_URL=

# --- Background jobs and cache (see Operations and "Cache and storage") ---
# Role of the container: all (default), web or worker; workers per container (1-32)
# ROLE=all
# MESSENGER_WORKERS=2
# Shared cache for several containers (Redis or Valkey); empty = files
# CACHE_DSN=redis://cache:6379
# CACHE_PREFIX=club-calendar
