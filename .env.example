# Deployment targets for Deployer (deploy.php). Copy to .env; .env is gitignored.
# Variables already set in the environment (e.g. CI secrets) win over this file.
#   npm run deploy -- staging

# Space-separated list of targets
DEPLOY_TARGETS="staging production"

# Per target: DEPLOY_<NAME>_<SETTING>  (NAME upper-cased, "-" becomes "_")
#   HOST      ssh hostname                                  (required)
#   USER      ssh user                                      (required)
#   PATH      deploy path; point the docroot to <PATH>/current/public   (required)
#   URL       public URL, baked into the frontend as VITE_API_URL        (required)
#   PORT      ssh port, default 22
#   KEY       ssh private key file, default: ssh-agent / ~/.ssh/config
#   PHP       remote php binary, default: first php on PATH
#   ENV_FILE  local file uploaded as shared .env.local (APP_SECRET, DATABASE_URL, ...)
#   MIGRATE   run doctrine migrations, default 1
DEPLOY_STAGING_HOST=staging.example.com
DEPLOY_STAGING_USER=deploy
DEPLOY_STAGING_PATH=/var/www/club-calendar
DEPLOY_STAGING_URL=https://staging.club-calendar.example.com
# DEPLOY_STAGING_ENV_FILE=./deploy/staging.env.local

DEPLOY_PRODUCTION_HOST=example.com
DEPLOY_PRODUCTION_USER=deploy
DEPLOY_PRODUCTION_PATH=/var/www/club-calendar
DEPLOY_PRODUCTION_URL=https://club-calendar.example.com
# DEPLOY_PRODUCTION_ENV_FILE=./deploy/production.env.local
