# Deployment targets for ./deploy.sh (copy to .env; .env is gitignored).
# Variables already set in the environment (e.g. CI secrets) win over this file.

# Space-separated list of targets and the one used when no argument is given
DEPLOY_TARGETS="staging production"
DEPLOY_DEFAULT_TARGET=staging

# Per target: DEPLOY_<NAME>_<SETTING>  (NAME upper-cased, "-" becomes "_")
#   SSH         user@host                                   (required)
#   PATH        remote backend dir; its public/ is the docroot   (required)
#   URL         public URL, baked into the frontend as VITE_API_URL (required)
#   SSH_PORT    default 22
#   SSH_KEY     private key file, default: ssh-agent / ~/.ssh/config
#   PHP         remote php binary, default "php"
#   ENV_FILE    local file uploaded as backend/.env.local (APP_SECRET, DATABASE_URL, ...)
#   MIGRATE     run doctrine migrations, default 1
DEPLOY_STAGING_SSH=deploy@staging.example.com
DEPLOY_STAGING_PATH=/var/www/club-calendar/backend
DEPLOY_STAGING_URL=https://staging.club-calendar.example.com
# DEPLOY_STAGING_ENV_FILE=./deploy/staging.env.local

DEPLOY_PRODUCTION_SSH=deploy@example.com
DEPLOY_PRODUCTION_PATH=/var/www/club-calendar/backend
DEPLOY_PRODUCTION_URL=https://club-calendar.example.com
# DEPLOY_PRODUCTION_ENV_FILE=./deploy/production.env.local
