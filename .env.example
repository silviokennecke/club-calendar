# Settings for the Deployer (deploy.php). Copy to .env; .env is gitignored.
# Variables already set in the environment (e.g. CI secrets) win over this file.
#   npm run deploy:build   /   npm run deploy

# Public URL of the deployment, baked into the frontend as VITE_API_URL
APP_URL=https://club-calendar.example.com

# Server (docroot = <DEPLOY_PATH>/current/public)
DEPLOY_HOST=example.com
DEPLOY_USER=deploy
DEPLOY_PATH=/var/www/app
# DEPLOY_PORT=22
# DEPLOY_KEY=~/.ssh/id_ed25519
# DEPLOY_PASSWORD=...   # only if the server has no key auth (needs OpenSSH >= 8.4)
# DEPLOY_PHP=/usr/bin/php8.4
