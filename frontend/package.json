{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:dev": "tsc -p tsconfig.app.json --noEmit && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "docs:screenshots": "DOCS_SCREENSHOTS=1 playwright test --project=docs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.101.0",
    "clsx": "^2.1.1",
    "emoji-mart": "^5.6.0",
    "fuse.js": "^7.5.0",
    "i18next": "^26.3.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.17.0",
    "mapbox-gl": "^3.24.0",
    "minisearch": "^7.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^25.0.1",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.62.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
