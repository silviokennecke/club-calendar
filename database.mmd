erDiagram
    user {
        int id PK
        varchar name
        varchar email
        varchar password
    }

    club {
        int id PK
        varchar name
        varchar timezone
    }

    calendar {
        int id PK
        int club_id FK
        varchar name
    }

    calendar_feed {
        %% publishing settings for a calendar
        %% a calendar feed can be subscribed publicly or privately using a shared secret
        int id PK
        int claendar_id FK
        varchar name
        string visibility "private|public; default=private"
        string shared_secret "auto generated; stored in plain text; required for access with visibility=private"
        boolean is_draft
    }

    property {
        %% e.g. Schützentracht
        int id PK
        int calendar_id FK
        varchar name
        varchar icon "NULL; utf8mb emoji; will be displayed next to event title"
    }

    feature {
        %% e.g. Bonusschießen
        int id PK
        int calendar_id FK
        varchar name
    }

    target_group {
        %% e.g. Schüler, Jugend, Erwachsene
        int id PK
        int calendar_id FK
        varchar name
    }

    location {
        int id PK
        int calendar_id FK
        varchar address
    }

    event_template {
        int id PK
        int calendar_id FK
        int location_id FK "NULL"
        varchar name
        varchar timezone
        time time_begin
        time time_end
    }

    event {
        int id PK
        int calendar_id FK
        int event_template_id FK "NULL"
        int location_id FK "NULL"
        varchar name
        varchar timezone "NULL"
        date date
        time time_begin
        time time_end
        boolean is_draft
    }

    club }o--o{ user : "manages"
    club ||--o{ calendar : "has"
    calendar ||--o{ calendar_feed : "provides"
    calendar ||--o{ property : "defines"
    calendar ||--o{ feature : "defines"
    calendar ||--o{ target_group : "defines"
    calendar ||--o{ location : "has"
    calendar ||--o{ event_template : "has"
    calendar ||--o{ event : "has"
    calendar_feed }o--o{ target_group : "filters by"
    location |o--o{ event : "at"
    location |o--o{ event_template : "default location"
    event_template |o--o{ event : "based on"
    event }o--o{ property : "has"
    event }o--o{ feature : "has"
    event }o--o{ target_group : "for"
    event_template }o--o{ property : "has"
    event_template }o--o{ feature : "has"
    event_template }o--o{ target_group : "for"