<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="KERNEL_CLASS" value="App\Kernel" />

        <!-- ###+ nelmio/cors-bundle ### -->
        <env name="CORS_ALLOW_ORIGIN" value="'^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'"/>
        <!-- ###- nelmio/cors-bundle ### -->

        <env name="MAILER_DSN" value="null://null"/>
        <!-- never pick up real legal texts; tests that need files build their own directory -->
        <env name="LEGAL_DOCUMENTS_PATH" value="/nonexistent/legal-documents"/>
        <env name="MAILER_FROM" value="noreply@test.example.com"/>

        <!-- URLs and passkey relying party the tests assert against; independent of backend/.env (which now derives them from APP_URL) -->
        <env name="APP_URL" value="http://localhost:8080" force="true"/>
        <env name="FRONTEND_URL" value="http://localhost:5173"/>
        <env name="BACKEND_URL" value="http://localhost:3001"/>
        <env name="WEBAUTHN_RP_ID" value="localhost"/>

        <!-- fixed throwaway OPAQUE test secrets; OPAQUE stays disabled unless a test enables it -->
        <env name="OPAQUE_OPRF_SEED" value="CMpJBSKfehZoZWhf1nHfDbeLoHLqdTPyxDsslG2cWvigxNDx9wx52LT8gZGjJmKVhAtssnafb7HBzgyLLFmHHg"/>
        <env name="OPAQUE_SERVER_PRIVATE_KEY" value="Y6e_zB9zGzUd8Jf95-YdKHpvRlmohT1x73eVy5lprAE"/>

        <!-- ###+ symfony/mailer ### -->
        <env name="MAILER_DSN" value="null://null"/>
        <!-- ###- symfony/mailer ### -->
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>performance</group>
            <group>interop</group>
        </exclude>
    </groups>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
    </extensions>
</phpunit>
