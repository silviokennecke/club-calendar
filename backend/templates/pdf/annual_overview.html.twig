{% extends 'pdf/base.html.twig' %}

{% block content %}
    <style>
        table.year { width: 100%; border-collapse: separate; border-spacing: 0; }
        td.ym { width: 25%; padding: 0 5pt 8pt 5pt; border: 0; vertical-align: top; }
        table.mini { table-layout: fixed; width: 100%; border-collapse: collapse; }
        table.mini th { text-align: center; font-size: 6pt; padding: 1pt 0; border: 0; border-bottom: 0.5pt solid #0b6b58; background-color: #ffffff; color: #0b6b58; }
        table.mini td { text-align: center; font-size: 7pt; padding: 2pt 0; border: 0; }
        table.mini td.we { background-color: #dcefe9; font-weight: bold; }
        table.mini td.has { font-weight: bold; background-color: #0b6b58; color: #ffffff; }
        div.mname { margin: 0 0 2pt 0; }
        table.evlist { margin-top: 4pt; }
        table.evlist td { font-size: 7pt; padding: 2pt 4pt; }
        table.evlist td.c1 { width: 20%; }
        table.evlist td.c2 { width: 14%; }
        .evpage { page-break-before: always; }
    </style>
    <table class="year">
        <colgroup><col style="width: 25%"><col style="width: 25%"><col style="width: 25%"><col style="width: 25%"></colgroup>
        <tbody>
        {% for row in months|batch(4) %}
            <tr>
            {% for month in row %}
                <td class="ym">
                    <div class="bar mname">{{ month.label }}</div>
                    <table class="mini">
                        <colgroup>{% for wd in weekdays %}<col style="width: 14.2857%">{% endfor %}</colgroup>
                        <thead>
                            <tr>{% for wd in weekdays %}<th>{{ wd|slice(0, 2) }}</th>{% endfor %}</tr>
                        </thead>
                        <tbody>
                        {% for week in month.weeks %}
                            <tr>
                            {% for cell in week %}
                                {% if cell is null %}
                                    <td>&nbsp;</td>
                                {% else %}
                                    <td class="{{ cell.hasEvents ? 'has' : (cell.weekend ? 'we' : 'no') }}">{{ cell.number }}</td>
                                {% endif %}
                            {% endfor %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </td>
            {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if events|length > 0 %}
        <div class="evpage">
            <div class="bar">{{ 'events'|trans({}, 'pdf', locale) }}</div>
            {% for chunk in events|batch(30) %}
            <table class="evlist">
                <tbody>
                {% for e in chunk %}
                    <tr class="{{ e.weekend ? 'we' : 'wd' }}">
                        <td class="c1 dc">{{ e.dateLabel }}</td>
                        <td class="c2">
                            {%- if e.allDay -%}
                                {{ 'all_day'|trans({}, 'pdf', locale) }}
                            {%- elseif e.continued and e.begin is null -%}
                                {{ 'continued'|trans({}, 'pdf', locale) }}
                            {%- else -%}
                                {{ e.begin }}
                            {%- endif -%}
                        </td>
                        <td>
                            {%- for path in e.emojiPaths %}<img class="emoji" src="{{ path }}"> {% endfor -%}
                            {{ e.name }}{% if e.draft %} <span class="draft">({{ 'draft'|trans({}, 'pdf', locale) }})</span>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
