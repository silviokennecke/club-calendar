{% extends 'pdf/base.html.twig' %}

{% block content %}
    <style>div.month { margin: 8pt 0 2pt 0; page-break-after: avoid; } tr.sch td { background-color: #f7e7b4; } tr.pub td { background-color: #f6cfd3; } tr.pub td.dc { font-weight: bold; }</style>
    {# Several short tables instead of one huge one: dompdf's table layout grows much faster than linearly #}
    {% for month in rows %}
        <div class="bar month">{{ month.label }}</div>
        {% for chunk in month.entries|batch(30) %}
        <table>
            <colgroup>
                <col style="width: 17%"><col style="width: 12%"><col style="width: 31%"><col style="width: 20%"><col style="width: 20%">
            </colgroup>
            <thead>
            <tr>
                <th>{{ 'col.date'|trans({}, 'pdf', locale) }}</th>
                <th>{{ 'col.time'|trans({}, 'pdf', locale) }}</th>
                <th>{{ 'col.name'|trans({}, 'pdf', locale) }}</th>
                <th>{{ 'col.location'|trans({}, 'pdf', locale) }}</th>
                <th>{{ 'col.tags'|trans({}, 'pdf', locale) }}</th>
            </tr>
        </thead>
            <tbody>
            {% for e in chunk %}
                {% if e.holidayName is defined %}
                <tr class="{{ e.shade }}">
                    <td class="dc">{{ e.dateLabel }}</td>
                    <td colspan="4"><b>{{ e.holidayName }}</b></td>
                </tr>
                {% else %}
                <tr class="{{ e.shade }}">
                    <td class="dc">{{ e.dateLabel }}</td>
                    <td>
                        {%- if e.allDay -%}
                            {{ 'all_day'|trans({}, 'pdf', locale) }}
                        {%- elseif e.continued and e.begin is null -%}
                            {{ 'continued'|trans({}, 'pdf', locale) }}{% if e.end is not null %} &ndash; {{ e.end }}{% endif %}
                        {%- else -%}
                            {{ e.begin }}{% if e.end is not null %} &ndash; {{ e.end }}{% endif %}
                        {%- endif -%}
                    </td>
                    <td>{{ e.name }}{% if e.draft %} <span class="draft">({{ 'draft'|trans({}, 'pdf', locale) }})</span>{% endif %}</td>
                    <td>{{ e.location }}</td>
                    <td>
                        {%- for path in e.emojiPaths %}<img class="emoji" src="{{ path }}"> {% endfor -%}
                        {{- e.tags|join(', ') -}}
                    </td>
                </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>
        {% endfor %}
    {% endfor %}
{% endblock %}
