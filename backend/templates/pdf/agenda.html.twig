{% extends 'pdf/base.html.twig' %}

{% block content %}
    <table>
        <colgroup>
            <col style="width: 17%"><col style="width: 12%"><col style="width: 31%"><col style="width: 20%"><col style="width: 20%">
        </colgroup>
        <thead>
            <tr>
                <th>{{ 'col.date'|trans({}, 'pdf', locale) }}</th>
                <th>{{ 'col.time'|trans({}, 'pdf', locale) }}</th>
                <th>{{ 'col.name'|trans({}, 'pdf', locale) }}</th>
                <th>{{ 'col.location'|trans({}, 'pdf', locale) }}</th>
                <th>{{ 'col.tags'|trans({}, 'pdf', locale) }}</th>
            </tr>
        </thead>
        <tbody>
        {% for month in rows %}
            <tr>
                <td colspan="5" style="background-color: #f3f3f3; font-weight: bold;">{{ month.label }}</td>
            </tr>
            {% for e in month.entries %}
                <tr>
                    <td>{{ e.dateLabel }}</td>
                    <td>
                        {%- if e.allDay -%}
                            {{ 'all_day'|trans({}, 'pdf', locale) }}
                        {%- elseif e.continued and e.begin is null -%}
                            {{ 'continued'|trans({}, 'pdf', locale) }}{% if e.end is not null %} &ndash; {{ e.end }}{% endif %}
                        {%- else -%}
                            {{ e.begin }}{% if e.end is not null %} &ndash; {{ e.end }}{% endif %}
                        {%- endif -%}
                    </td>
                    <td>{{ e.name }}{% if e.draft %} <span class="draft">({{ 'draft'|trans({}, 'pdf', locale) }})</span>{% endif %}</td>
                    <td>{{ e.location }}</td>
                    <td>
                        {%- for path in e.emojiPaths %}<img class="emoji" src="{{ path }}"> {% endfor -%}
                        {{- e.tags|join(', ') -}}
                    </td>
                </tr>
            {% endfor %}
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
