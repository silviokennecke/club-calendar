<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ calendarName }}</title>
    <style>
        @page { size: {{ pageSize }}; margin: 15mm 12mm 18mm 12mm; }
        body { font-family: "DejaVu Sans", sans-serif; font-size: 8pt; color: #1a1a1a; }
        h1 { font-size: 14pt; margin: 0 0 2pt 0; }
        h2 { font-size: 10pt; margin: 14pt 0 4pt 0; }
        .sub { color: #555555; margin: 0 0 10pt 0; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        th { text-align: left; background-color: #e8e8e8; padding: 3pt 4pt; border-bottom: 1pt solid #888888; }
        td { padding: 3pt 4pt; border-bottom: 0.5pt solid #cccccc; vertical-align: top; }
        thead { display: table-header-group; }
        tr { page-break-inside: avoid; }
        img.emoji { width: 9pt; height: 9pt; }
        img.emoji-lg { width: 11pt; height: 11pt; }
        .draft { color: #b45309; font-size: 7pt; }
        #footer { position: fixed; left: 0; right: 0; bottom: -12mm; font-size: 7pt; color: #777777; }
    </style>
</head>
<body>
    <div id="footer">{{ 'generated_on'|trans({'date': generatedAt}, 'pdf', locale) }} &middot; {{ clubName }}</div>
    <h1>{{ calendarName }}</h1>
    <p class="sub">{{ clubName }} &middot; {{ 'period'|trans({'from': from, 'to': to}, 'pdf', locale) }}</p>
    {% block content %}{% endblock %}
    {% if legend|length > 0 %}
        <h2>{{ 'legend'|trans({}, 'pdf', locale) }}</h2>
        <table>
            <tbody>
            {% for item in legend %}
                <tr>
                    <td style="width: 8%"><img class="emoji-lg" src="{{ item.emojiPath }}"></td>
                    <td>{{ item.names|join(', ') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</body>
</html>
