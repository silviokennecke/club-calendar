{% extends 'pdf/base.html.twig' %}

{# Printed per page inside the content block instead #}
{% block header %}{% endblock %}

{% block content %}
    <style>
        table.q { table-layout: fixed; width: 100%; border-collapse: separate; border-spacing: 0; }
        table.q td { padding: 0; border: 0; vertical-align: top; }
        table.q td.col { width: 32%; }
        table.q td.gap { width: 2%; }
        table.q td.hd { height: 21pt; padding: 0 0 3pt 0; font-size: 8pt; vertical-align: bottom; }
        table.m { table-layout: fixed; width: 100%; border-collapse: separate; border-spacing: 0; border: 0.5pt solid #555555; border-top: 0; }
        table.m td { padding: 0; border: 0; border-bottom: 0.5pt solid #cfd7d2; vertical-align: top; overflow: hidden; }
        table.m td.n { width: 9%; text-align: right; padding-right: 2pt; }
        table.m td.w { width: 12%; padding-left: 1pt; }
        table.m td.ev { width: 79%; padding-right: 1pt; }
        table.m tr.we td { background-color: #dcefe9; }
        table.m tr.we td.n, table.m tr.we td.w { font-weight: bold; }
        table.m tr.grey td { background-color: #e6e6e6; }
        .ln { height: 1pt; overflow: hidden; white-space: nowrap; }
        .ln.dr { color: #b45309; font-style: italic; }
        .legend { margin: 4pt 0 0 0; font-size: 7pt; color: #333333; }
        .qp { page-break-before: always; }
        .qp-first { page-break-before: avoid; }
    </style>
    {% for page in pages %}
        {% set lh = page.lineHeightPt|number_format(2, '.', '') %}
        <style>
            .p{{ loop.index }} { font-size: {{ page.fontPt|number_format(2, '.', '') }}pt; line-height: {{ lh }}pt; }
            .p{{ loop.index }} table.m td.r { height: {{ page.rowHeightPt|number_format(2, '.', '') }}pt; }
            .p{{ loop.index }} .ln { height: {{ lh }}pt; line-height: {{ page.fontPt|number_format(2, '.', '') }}pt; }
            .p{{ loop.index }} img.emoji { width: {{ page.emojiPt|number_format(2, '.', '') }}pt; height: {{ page.emojiPt|number_format(2, '.', '') }}pt; }
        </style>
        <div class="p{{ loop.index }} {{ loop.first ? 'qp-first' : 'qp' }}">
            <table class="q">
                <tbody>
                    <tr>
                        <td class="col hd club"><div class="t">{{ clubName }}</div></td>
                        <td class="gap hd">&nbsp;</td>
                        <td class="col hd cal"><div class="t">{{ calendarName }}</div><div class="s">{{ 'period'|trans({'from': from, 'to': to}, 'pdf', locale) }}</div></td>
                        <td class="gap hd">&nbsp;</td>
                        <td class="col hd">&nbsp;</td>
                    </tr>
                    <tr>
                    {% for month in page.months %}
                        {% if not loop.first %}<td class="gap">&nbsp;</td>{% endif %}
                        <td class="col">
                            <div class="bar">{{ month.label }}</div>
                            <table class="m">
                                <tbody>
                                {% for row in month.rows %}
                                    {% if row.kind == 'day' %}
                                    <tr class="{{ row.weekend ? 'we' : 'wd' }}">
                                        <td class="r n">{{ row.number }}</td>
                                        <td class="r w">{{ row.weekday }}</td>
                                        <td class="r ev">
                                            {%- for e in row.events -%}
                                                <div class="ln{{ e.draft ? ' dr' : '' }}">
                                                    {%- if e.time is not null %}{{ e.time }} {% endif -%}
                                                    {%- for path in e.emojiPaths %}<img class="emoji" src="{{ path }}">{% endfor -%}
                                                    {%- if e.emojiPaths|length > 0 %} {% endif -%}
                                                    {{- e.text -}}
                                                </div>
                                            {%- endfor -%}
                                        </td>
                                    </tr>
                                    {% else %}
                                    <tr class="grey"><td colspan="3" style="height: {{ (row.lines * page.lineHeightPt)|number_format(2, '.', '') }}pt">&nbsp;</td></tr>
                                    {% endif %}
                                {% endfor %}
                                </tbody>
                            </table>
                        </td>
                    {% endfor %}
                    {% if page.months|length < 3 %}{% for i in range(page.months|length, 2) %}<td class="gap">&nbsp;</td><td class="col">&nbsp;</td>{% endfor %}{% endif %}
                    </tr>
                </tbody>
            </table>
            {% if page.legend|length > 0 %}
                <div class="legend">
                    {%- for item in page.legend -%}
                        <img class="emoji" src="{{ item.emojiPath }}"> {{ item.names|join(', ') }}{% if not loop.last %}; {% endif %}
                    {%- endfor -%}
                </div>
            {% endif %}
        </div>
    {% endfor %}
{% endblock %}
