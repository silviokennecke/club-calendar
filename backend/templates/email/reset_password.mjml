<mjml>
  <mj-head>
    <mj-title>{{ 'email.reset.subject'|trans }}</mj-title>
    <mj-preview>{{ 'email.reset.subject'|trans }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="{{ THEME.colors.text }}" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{ THEME.colors.background }}">
    <mj-section background-color="{{ THEME.colors.surface }}" padding="40px 30px">
      <mj-column>
        <mj-include path="./_components/header.mjml" />

        <mj-text font-size="18px" font-weight="bold" padding-bottom="8px">
          {{ 'email.reset.greeting'|trans({name: userName}) }}
        </mj-text>
        <mj-text padding-bottom="24px">
          {{ 'email.reset.body'|trans }}
        </mj-text>

        <!-- CTA button component with fallback link -->
        {% set buttonUrl = resetUrl %}
        {% set buttonText = 'email.reset.button'|trans %}
        <mj-include path="./_components/button.mjml" />

        <mj-text font-size="13px" color="{{ THEME.colors.textMuted }}" padding-top="24px">
          {{ 'email.reset.expiry_note'|trans }}
        </mj-text>
        <mj-text font-size="13px" color="{{ THEME.colors.textMuted }}">
          {{ 'email.reset.ignore_note'|trans }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
