<mjml>
  <mj-head>
    <mj-title>{{ 'email.failed_step_ups.subject'|trans }}</mj-title>
    <mj-preview>{{ 'email.failed_step_ups.subject'|trans }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="{{ THEME.fonts.family }}" />
      <mj-text font-size="{{ THEME.fonts.size.body }}" color="{{ THEME.colors.text }}" line-height="{{ THEME.fonts.lineHeight.normal }}" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{ THEME.colors.background }}">
    <mj-section background-color="{{ THEME.colors.surface }}" padding="{{ THEME.spacing.xxl }} {{ THEME.spacing.xl }}">
      <mj-column>
        <mj-include path="./_components/header.mjml" />

        <mj-text font-size="{{ THEME.fonts.size.heading }}" font-weight="bold" padding-bottom="8px">
          {{ 'email.failed_step_ups.greeting'|trans({name: userName}) }}
        </mj-text>
        <mj-text padding-bottom="16px">
          {{ 'email.failed_step_ups.body'|trans({count: count}) }}
        </mj-text>
        <mj-include path="./_components/client-details.mjml" />
        <mj-text padding-bottom="16px">
          {{ 'email.failed_step_ups.info'|trans }}
        </mj-text>

        {% set noticeText = 'email.failed_step_ups.not_you'|trans %}
        {% set noticeTitle = 'email.notice.not_you_title'|trans %}
        {% set noticeLink = forgotUrl %}
        <mj-include path="./_components/notice-warning.mjml" />

        <mj-text font-size="{{ THEME.fonts.size.small }}" color="{{ THEME.colors.textMuted }}" padding="8px 0 0 0">
          {{ 'email.notice.automatic'|trans }}
        </mj-text>


        <mj-include path="./_components/footer.mjml" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
