<!--
  EXAMPLE: Refactored reset_password.mjml using reusable components

  This file demonstrates how to use the component library to build
  clean, maintainable email templates. It's NOT compiled as a real template.

  To migrate an existing template:
  1. Copy this structure
  2. Replace placeholders with your content
  3. Run npm run build:mail to compile
  4. Verify the HTML output looks correct
-->

<mjml>
  <mj-head>
    <mj-title>{{ 'email.reset.subject'|trans }}</mj-title>
    <mj-preview>{{ 'email.reset.subject'|trans }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" color="#14221e" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f7f8f5">
    <!-- Main content section with theme background colors -->
    <mj-section background-color="#ffffff" padding="40px 30px">
      <mj-column>
        <!-- Brand header component -->
        <mj-include path="./_components/header.mjml" />

        <!-- Greeting text -->
        <mj-text font-size="18px" font-weight="bold" padding-bottom="8px">
          {{ 'email.reset.greeting'|trans({name: userName}) }}
        </mj-text>

        <!-- Body copy -->
        <mj-text padding-bottom="24px">
          {{ 'email.reset.body'|trans }}
        </mj-text>

        <!-- CTA button component with fallback link -->
        <!--
          The button component requires these variables:
          - buttonUrl: The action URL (resetUrl in this case)
          - buttonText: The button label (translated text)
        -->
        {% set buttonUrl = resetUrl %}
        {% set buttonText = 'email.reset.button'|trans %}
        <mj-include path="./_components/button.mjml" />

        <!-- Informational notes (consistency with theme colors) -->
        <mj-text font-size="13px" color="#4a5b55" padding-top="24px">
          {{ 'email.reset.expiry_note'|trans }}
        </mj-text>
        <mj-text font-size="13px" color="#4a5b55">
          {{ 'email.reset.ignore_note'|trans }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Optional: Footer component (currently a placeholder) -->
    <!-- <mj-include path="./_components/footer.mjml" /> -->
  </mj-body>
</mjml>

<!--
  Benefits of using this component structure:

  1. CONSISTENCY
     - All templates use the same header, colors, and spacing
     - Brand identity is centralized and easy to update

  2. MAINTAINABILITY
     - Change the header emoji? Update _components/header.mjml once
     - Update button styling? Change _components/button.mjml
     - No need to hunt through multiple template files

  3. REUSABILITY
     - Same button component in password reset, email verification, etc.
     - Same section styling in all templates
     - Copy the example structure for new templates

  4. SCALABILITY
     - Adding new email types? Start with this example
     - New template = copy example → update i18n keys and URLs
     - Component changes propagate to all templates automatically

  5. DEBUGGING
     - Isolated components are easier to test
     - Changes to button.mjml don't affect header behavior
     - Clear separation of concerns
-->
