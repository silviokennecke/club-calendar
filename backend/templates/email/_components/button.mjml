<!-- CTA Button component with fallback link.
     NOTE: keep this comment free of Twig tags and mj-include tags: the mail builder inlines the whole
     file (comment included) and Twig evaluates tags inside HTML comments.
     See USAGE.md for how to include the component.

     Required Twig variables in the including template: buttonUrl (the link) and buttonText (the label).
     Theme styling: primary color #2563eb, white text, border radius 6px, 16px font, padding 12px 24px,
     fallback link below the button for clients that do not render buttons.
-->

<!-- Primary CTA Button -->
<mj-button
  href="{{ buttonUrl }}"
  background-color="#2563eb"
  color="#ffffff"
  border-radius="6px"
  font-size="16px"
  padding="12px 24px"
>
  {{ buttonText }}
</mj-button>

<!-- Fallback link text for button-unsupported clients -->
<mj-text font-size="13px" color="#888888" padding-top="12px">
  Or copy this link:<br />
  <a href="{{ buttonUrl }}" style="color:#2563eb;word-break:break-all;">{{ buttonUrl }}</a>
</mj-text>
