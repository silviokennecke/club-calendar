<!-- CTA button (redesign) with fallback link.
     NOTE: keep this comment free of Twig tags and mj-include tags: the mail builder inlines the whole
     file (comment included) and Twig evaluates tags inside HTML comments.

     Required Twig variables in the including template: buttonUrl (the link) and buttonText (the label).
     Colors, fonts and sizes come from the theme (config/mail-theme.js), min height 44px, copyable link below.
-->
<mj-button
  href="{{ buttonUrl }}"
  background-color="{{ THEME.components.button.backgroundColor }}"
  color="{{ THEME.components.button.textColor }}"
  border-radius="{{ THEME.components.button.borderRadius }}"
  font-family="{{ THEME.fonts.family }}"
  font-size="{{ THEME.components.button.fontSize }}"
  font-weight="700"
  inner-padding="{{ THEME.components.button.paddingVertical }} {{ THEME.components.button.paddingHorizontal }}"
  padding="8px 0 16px 0"
  align="left"
>
  {{ buttonText }}
</mj-button>

<!-- Fallback link text for button-unsupported clients -->
<mj-text font-family="{{ THEME.fonts.family }}" font-size="{{ THEME.fonts.size.small }}" line-height="20px" color="{{ THEME.colors.textMuted }}" padding="0 0 16px 0">
  Or copy this link:<br />
  <a href="{{ buttonUrl }}" style="color:{{ THEME.colors.primary }};word-break:break-all;">{{ buttonUrl }}</a>
</mj-text>
