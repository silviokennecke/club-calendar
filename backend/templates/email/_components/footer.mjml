<!-- Footer (redesign): hairline, small muted brand line. No parameters, no links (the app has no imprint URL for mails).
     Usage: include as the last element inside the content column.
-->
<mj-divider border-width="1px" border-color="{{ THEME.colors.border }}" padding="16px 0 12px 0" />
<mj-text font-family="{{ THEME.fonts.family }}" font-size="{{ THEME.fonts.size.small }}" line-height="20px" color="{{ THEME.colors.textMuted }}" padding="0">
  {{ THEME.brand.name }}
</mj-text>
