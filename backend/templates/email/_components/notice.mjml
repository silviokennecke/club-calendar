<!-- Notice box (redesign): neutral info panel (sunken background, brand left bar) for hints and security notes.
     NOTE: keep this comment free of Twig tags and mj-include tags.

     Required Twig variable in the including template: noticeText (already translated text, escaped by Twig).
     Optional: noticeTitle (bold first line, default none) and noticeLink (URL shown as a link below the text, default none).
     Colors and fonts come from the theme (config/mail-theme.js).
     Built as an inline-styled table in mj-raw, because mj-text has no background, border or radius.
-->
<mj-raw>
  <tr><td style="padding:8px 0 16px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;background-color:{{ THEME.colors.sunken }};border-left:4px solid {{ THEME.colors.primary }};border-radius:6px;">
      <tr><td style="padding:12px 16px;font-family:{{ THEME.fonts.family }};font-size:{{ THEME.fonts.size.label }};line-height:22px;color:{{ THEME.colors.text }};">{% if noticeTitle %}<strong>{{ noticeTitle }}</strong><br />{% endif %}{{ noticeText }}{% if noticeLink %}<br /><a href="{{ noticeLink }}" style="color:{{ THEME.colors.primary }};word-break:break-all;">{{ noticeLink }}</a>{% endif %}</td></tr>
    </table>
  </td></tr>
</mj-raw>
