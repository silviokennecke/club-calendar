<!--
  EXAMPLE: Refactored verify_email.mjml using reusable components

  This shows an alternative template structure without a button,
  demonstrating how the header component is reusable across different
  email types.

  Key differences from password reset email:
  - No button (code is displayed inline instead)
  - Different body content
  - Same header and overall structure
-->

<mjml>
  <mj-head>
    <mj-title>{{ 'email.verify.subject'|trans }}</mj-title>
    <mj-preview>{{ 'email.verify.subject'|trans }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 30px">
      <mj-column>
        <!-- Brand header component - same across all templates -->
        <mj-include path="./_components/header.mjml" />

        <!-- Greeting -->
        <mj-text font-size="18px" font-weight="bold" padding-bottom="8px">
          {{ 'email.verify.greeting'|trans({name: userName}) }}
        </mj-text>

        <!-- Body text -->
        <mj-text padding-bottom="24px">
          {{ 'email.verify.body'|trans }}
        </mj-text>

        <!-- Code display (unique to verification emails) -->
        <!-- Monospace, bold, with padding for visual emphasis -->
        <mj-text
          align="center"
          font-size="36px"
          font-weight="bold"
          letter-spacing="10px"
          color="#111111"
          container-background-color="#f4f4f4"
          padding="16px 24px"
        >
          {{ code }}
        </mj-text>

        <!-- Expiry and security notes -->
        <mj-text font-size="13px" color="#888888" padding-top="24px">
          {{ 'email.verify.expiry_note'|trans({minutes: validMinutes}) }}
        </mj-text>
        <mj-text font-size="13px" color="#888888">
          {{ 'email.verify.ignore_note'|trans }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<!--
  Component reuse notes for this template:

  1. HEADER
     - Uses the same header.mjml as all other templates
     - Ensures consistent branding across email types

  2. NO BUTTON COMPONENT
     - Verification emails don't use a CTA button
     - Code is displayed directly for the user to copy
     - This is a legitimate alternative to button.mjml

  3. CONSISTENT STYLING
     - All text colors follow theme (primary, muted)
     - Padding and spacing match other templates
     - Background colors from the theme palette

  4. UNIQUE CONTENT PATTERN
     - Shows how templates can be different while maintaining consistency
     - Demonstrates that components aren't mandatory for every element
     - Use components where they reduce duplication (header, buttons)
     - Keep unique patterns in the main template file
-->
