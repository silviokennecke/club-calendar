<!-- Details of the request behind a security notice (time, IP address, location, browser).
     NOTE: keep this comment free of Twig tags and mj-include tags.

     Required Twig variables in the including template: when, ip, place, browser (already translated, escaped by Twig).
     Colors and fonts come from the theme (config/mail-theme.js).
     Built as an inline-styled table in mj-raw, because mj-text has no background, border or radius.
-->
<mj-raw>
  <tr><td style="padding:0 0 16px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;background-color:{{ THEME.colors.sunken }};border-radius:6px;">
      <tr><td style="padding:12px 16px;font-family:{{ THEME.fonts.family }};font-size:{{ THEME.fonts.size.label }};line-height:22px;color:{{ THEME.colors.text }};">
        <strong>{{ 'email.notice.details_time'|trans }}:</strong> {{ when }}<br />
        <strong>{{ 'email.notice.details_ip'|trans }}:</strong> {{ ip }}<br />
        <strong>{{ 'email.notice.details_location'|trans }}:</strong> {{ place }}<br />
        <strong>{{ 'email.notice.details_browser'|trans }}:</strong> {{ browser }}
      </td></tr>
    </table>
  </td></tr>
</mj-raw>
