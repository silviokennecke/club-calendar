<mjml>
  <mj-head>
    <mj-title>{{ 'email.delete_code.subject'|trans }}</mj-title>
    <mj-preview>{{ 'email.delete_code.subject'|trans }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="{{ THEME.colors.text }}" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{ THEME.colors.background }}">
    <mj-section background-color="{{ THEME.colors.surface }}" padding="40px 30px">
      <mj-column>
        <mj-include path="./_components/header.mjml" />

        <mj-text font-size="18px" font-weight="bold" padding-bottom="8px">
          {{ 'email.delete_code.greeting'|trans({name: userName}) }}
        </mj-text>
        <mj-text padding-bottom="24px">
          {{ 'email.delete_code.body'|trans }}
        </mj-text>

        <!-- Code display (unique to verification emails) -->
        <!-- Monospace, bold, with padding for visual emphasis -->
        <mj-text align="center" font-size="36px" font-weight="bold" letter-spacing="10px" color="{{ THEME.colors.text }}" container-background-color="{{ THEME.colors.background }}" padding="16px 24px">
          {{ code }}
        </mj-text>

        <mj-text font-size="13px" color="{{ THEME.colors.textMuted }}" padding-top="24px">
          {{ 'email.delete_code.expiry_note'|trans({minutes: validMinutes}) }}
        </mj-text>
        <mj-text font-size="13px" color="{{ THEME.colors.textMuted }}">
          {{ 'email.delete_code.ignore_note'|trans }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
