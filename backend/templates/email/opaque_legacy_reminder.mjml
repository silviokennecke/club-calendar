<mjml>
  <mj-head>
    <mj-title>{{ 'email.opaque_reminder.subject'|trans }}</mj-title>
    <mj-preview>{{ 'email.opaque_reminder.subject'|trans }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="{{ THEME.fonts.family }}" />
      <mj-text font-size="{{ THEME.fonts.size.body }}" color="{{ THEME.colors.text }}" line-height="{{ THEME.fonts.lineHeight.normal }}" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{ THEME.colors.background }}">
    <mj-section background-color="{{ THEME.colors.surface }}" padding="{{ THEME.spacing.xxl }} {{ THEME.spacing.xl }}">
      <mj-column>
        <mj-include path="./_components/header.mjml" />

        <mj-text font-size="{{ THEME.fonts.size.heading }}" font-weight="bold" padding-bottom="8px">
          {{ 'email.opaque_reminder.greeting'|trans({name: userName}) }}
        </mj-text>
        <mj-text padding-bottom="16px">
          {{ 'email.opaque_reminder.body'|trans({date: deadline}) }}
        </mj-text>

        {% set buttonUrl = loginUrl %}
        {% set buttonText = 'email.opaque_reminder.button'|trans %}
        <mj-include path="./_components/button.mjml" />

        <mj-text padding-bottom="16px">
          {{ 'email.opaque_reminder.forgot'|trans }}
          <a href="{{ forgotUrl }}" style="color:{{ THEME.colors.primary }};word-break:break-all;">{{ forgotUrl }}</a>
        </mj-text>

        {% set noticeText = 'email.opaque_reminder.no_action'|trans %}
        <mj-include path="./_components/notice.mjml" />


        <mj-include path="./_components/footer.mjml" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
