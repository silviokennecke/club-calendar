<mjml>
  <mj-head>
    <mj-title>{{ 'email.password_changed.subject'|trans }}</mj-title>
    <mj-preview>{{ 'email.password_changed.subject'|trans }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="{{ THEME.colors.text }}" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{ THEME.colors.background }}">
    <mj-section background-color="{{ THEME.colors.surface }}" padding="40px 30px">
      <mj-column>
        <mj-include path="./_components/header.mjml" />

        <mj-text font-size="18px" font-weight="bold" padding-bottom="8px">
          {{ 'email.password_changed.greeting'|trans({name: userName}) }}
        </mj-text>
        <mj-text padding-bottom="16px">
          {{ 'email.password_changed.body'|trans({when: when}) }}
        </mj-text>
        <mj-text padding-bottom="16px">
          {{ 'email.password_changed.info'|trans }}
        </mj-text>
        <mj-text font-size="14px" color="{{ THEME.colors.text }}" padding-bottom="8px" font-weight="bold">
          {{ 'email.notice.not_you_title'|trans }}
        </mj-text>
        <mj-text font-size="14px" color="{{ THEME.colors.text }}">
          {{ 'email.password_changed.not_you'|trans }}<br />
          <a href="{{ forgotUrl }}" style="color:{{ THEME.colors.primary }};word-break:break-all;">{{ forgotUrl }}</a>
        </mj-text>
        <mj-text font-size="13px" color="{{ THEME.colors.textMuted }}" padding-top="24px">
          {{ 'email.notice.automatic'|trans }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
