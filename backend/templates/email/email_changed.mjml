<mjml>
  <mj-head>
    <mj-title>{{ 'email.email_changed.subject'|trans }}</mj-title>
    <mj-preview>{{ 'email.email_changed.subject'|trans }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 30px">
      <mj-column>
        <mj-text font-size="14px" color="#888888" padding-bottom="16px">
          📅 Club Calendar
        </mj-text>
        <mj-text font-size="18px" font-weight="bold" padding-bottom="8px">
          {{ 'email.email_changed.greeting'|trans({name: userName}) }}
        </mj-text>
        <mj-text padding-bottom="16px">
          {{ 'email.email_changed.body'|trans({when: when, email: maskedEmail}) }}
        </mj-text>
        <mj-text padding-bottom="16px">
          {{ 'email.email_changed.info'|trans }}
        </mj-text>
        <mj-text font-size="14px" color="#333333" padding-bottom="8px" font-weight="bold">
          {{ 'email.notice.not_you_title'|trans }}
        </mj-text>
        <mj-text font-size="14px" color="#333333">
          {{ 'email.email_changed.not_you'|trans }}<br />
          <a href="{{ forgotUrl }}" style="color:#2563eb;word-break:break-all;">{{ forgotUrl }}</a>
        </mj-text>
        <mj-text font-size="13px" color="#888888" padding-top="24px">
          {{ 'email.notice.automatic'|trans }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
