# Serves the built SPA (index.html + assets) and the Symfony API from one docroot.
#   /api/*        -> Symfony front controller (index.php)
#   existing file -> served as is
#   anything else -> SPA (index.html), so client-side routes survive a reload
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Bearer token through to PHP (Apache strips it by default under CGI/FPM)
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Never expose the front controller under its own name
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) /$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^api(?:/|$) index.php [L]

    RewriteRule ^ index.html [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

# Hashed build assets can be cached forever; index.html must always be revalidated
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# Feed pages (SPA) and feed API: never send a Referer.
# THE_REQUEST is the original request line, so this also matches after the rewrite to index.html.
<IfModule mod_headers.c>
    <If "%{THE_REQUEST} =~ m#^[A-Z]+ /(api/)?feed/#">
        Header always set Referrer-Policy "no-referrer"
    </If>
</IfModule>

# Keep dotfiles private
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
