# Serves the built SPA (index.html + assets) and the Symfony API from one docroot.
#   /api/*        -> Symfony front controller (index.php)
#   existing file -> served as is
#   anything else -> SPA (index.html), so client-side routes survive a reload
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Bearer token through to PHP (Apache strips it by default under CGI/FPM)
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Never expose the front controller under its own name
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) /$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^api(?:/|$) index.php [L]

    RewriteRule ^ index.html [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

# Hashed build assets can be cached forever; index.html must always be revalidated
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# Feed pages (SPA) and feed API: never send a Referer.
# THE_REQUEST is the original request line, so this also matches after the rewrite to index.html.
<IfModule mod_headers.c>
    <If "%{THE_REQUEST} =~ m#^[A-Z]+ /(api/)?feed/#">
        Header always set Referrer-Policy "no-referrer"
    </If>
</IfModule>

# Security headers (audit M4). KEEP IN SYNC with docker/Caddyfile (tests/Unit/SecurityHeadersConfigTest.php).
# CSP rules: no inline scripts, no eval; every new third-party host goes into the policy in BOTH files.
# The app proxies Mapbox through /api/mapbox, so there are no third-party hosts.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Default only: the feed rule above keeps no-referrer
    Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS only over HTTPS (directly or behind a TLS terminator that sets X-Forwarded-Proto)
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
</IfModule>

# Never serve secrets or logs
<FilesMatch "\.(env|pem|log)$">
    Require all denied
</FilesMatch>

# Keep dotfiles private
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
