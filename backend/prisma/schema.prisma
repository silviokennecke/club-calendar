generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  password      String?        @db.VarChar(255)
  dateFormat     String  @default("dd.MM.yyyy") @db.VarChar(20)
  firstDayOfWeek Int     @default(1)
  lastClubId     Int?
  lastCalendarId Int?
  clubs         ClubUser[]
  passkeys      Passkey[]
  oauthAccounts OAuthAccount[]
}

model Club {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  timezone  String     @default("Europe/Berlin") @db.VarChar(100)
  users     ClubUser[]
  calendars Calendar[]
}

model ClubUser {
  clubId Int
  userId Int
  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
}

model Calendar {
  id           Int             @id @default(autoincrement())
  clubId       Int
  name         String          @db.VarChar(255)
  timezone  String? @db.VarChar(100)
  club         Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  feeds        CalendarFeed[]
  properties   Property[]
  features     Feature[]
  targetGroups TargetGroup[]
  locations    Location[]
  templates    EventTemplate[]
  events       Event[]
}

enum FeedVisibility {
  PUBLIC
  PRIVATE
}

model CalendarFeed {
  id           Int                      @id @default(autoincrement())
  calendarId   Int
  name         String                   @db.VarChar(255)
  visibility   FeedVisibility           @default(PRIVATE)
  sharedSecret String                   @unique @db.VarChar(255)
  isDraft      Boolean                  @default(true)
  calendar     Calendar                 @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  targetGroups CalendarFeedTargetGroup[]
}

model CalendarFeedTargetGroup {
  feedId        Int
  targetGroupId Int
  feed          CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  targetGroup   TargetGroup  @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)

  @@id([feedId, targetGroupId])
}

model Property {
  id         Int                     @id @default(autoincrement())
  calendarId Int
  name       String                  @db.VarChar(255)
  icon       String?                 @db.VarChar(32)
  calendar   Calendar                @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  events     EventProperty[]
  templates  EventTemplateProperty[]
}

model Feature {
  id         Int                    @id @default(autoincrement())
  calendarId Int
  name       String                 @db.VarChar(255)
  calendar   Calendar               @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  events     EventFeature[]
  templates  EventTemplateFeature[]
}

model TargetGroup {
  id         Int                        @id @default(autoincrement())
  calendarId Int
  name       String                     @db.VarChar(255)
  calendar   Calendar                   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  events     EventTargetGroup[]
  templates  EventTemplateTargetGroup[]
  feeds      CalendarFeedTargetGroup[]
}

model Location {
  id         Int             @id @default(autoincrement())
  calendarId Int
  name       String?         @db.VarChar(255)
  street     String?         @db.VarChar(255)
  zip        String?         @db.VarChar(20)
  city       String?         @db.VarChar(255)
  country    String?         @db.VarChar(100)
  latitude   Float?
  longitude  Float?
  calendar   Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  events     Event[]
  templates  EventTemplate[]
}

model EventTemplate {
  id           Int                        @id @default(autoincrement())
  calendarId   Int
  locationId   Int?
  name         String                     @db.VarChar(255)
  timezone     String                     @db.VarChar(100)
  timeBegin    String                     @db.VarChar(5)
  timeEnd      String                     @db.VarChar(5)
  calendar     Calendar                   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  location     Location?                  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  events       Event[]
  properties   EventTemplateProperty[]
  features     EventTemplateFeature[]
  targetGroups EventTemplateTargetGroup[]
}

model EventTemplateProperty {
  templateId Int
  propertyId Int
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([templateId, propertyId])
}

model EventTemplateFeature {
  templateId Int
  featureId  Int
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  feature    Feature       @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([templateId, featureId])
}

model EventTemplateTargetGroup {
  templateId    Int
  targetGroupId Int
  template      EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  targetGroup   TargetGroup   @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)

  @@id([templateId, targetGroupId])
}

model Event {
  id              Int                @id @default(autoincrement())
  calendarId      Int
  eventTemplateId Int?
  locationId      Int?
  name            String             @db.VarChar(255)
  timezone        String?            @db.VarChar(100)
  date            DateTime           @db.Date
  dateEnd         DateTime?          @db.Date
  timeBegin       String             @db.VarChar(5)
  timeEnd         String             @db.VarChar(5)
  isAllDay        Boolean            @default(false)
  isDraft         Boolean            @default(true)
  calendar        Calendar           @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  template        EventTemplate?     @relation(fields: [eventTemplateId], references: [id], onDelete: SetNull)
  location        Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  properties      EventProperty[]
  features        EventFeature[]
  targetGroups    EventTargetGroup[]
}

model EventProperty {
  eventId    Int
  propertyId Int
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([eventId, propertyId])
}

model EventFeature {
  eventId   Int
  featureId Int
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([eventId, featureId])
}

model EventTargetGroup {
  eventId       Int
  targetGroupId Int
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetGroup   TargetGroup @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)

  @@id([eventId, targetGroupId])
}

model Passkey {
  id           String   @id @default(cuid())
  userId       Int
  credentialId String   @unique @db.VarChar(700)
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceName   String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthAccount {
  id         Int     @id @default(autoincrement())
  userId     Int
  provider   String  @db.VarChar(50)
  providerId String  @db.VarChar(255)
  email      String? @db.VarChar(255)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}
